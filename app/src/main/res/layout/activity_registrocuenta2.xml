<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_pantalla">

        <ImageView
            android:id="@+id/image_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/casas1"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_card_top" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/overlay_imagen"
            app:layout_constraintBottom_toBottomOf="@id/image_background"
            app:layout_constraintEnd_toEndOf="@id/image_background"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/image_background"
            app:layout_constraintTop_toTopOf="@id/image_background"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/btn_regresar_registro2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regresar"
            android:textColor="@color/texto_sobre_imagen"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="8dp"
            android:drawableTint="@color/texto_sobre_imagen"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/logo_icon"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo_yipshare"
            android:contentDescription="@null"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toTopOf="@id/image_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_card_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="278dp" />

        <LinearLayout
            android:id="@+id/card_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:elevation="8dp"
            android:padding="15dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="@id/guideline_card_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.85">

            <TextView
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="REGISTRAR CUENTA"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tv_error"
                style="@style/TextError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Error de inicio de sesión"
                android:visibility="gone" />

            <EditText
                android:id="@+id/usuario_IS"
                style="@style/InputBrand"
                android:autofillHints="username"
                android:hint="Usuario"
                android:inputType="textNoSuggestions"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/contraseña"
                style="@style/InputBrand"
                android:autofillHints="password"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/contraseña_confirmacion"
                style="@style/InputBrand"
                android:autofillHints="password"
                android:hint="Confirmar Contraseña"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <ProgressBar
                android:id="@+id/pbSubida"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btn_siguiente"
                style="@style/ButtonPrimary"
                android:text="Crear Cuenta"
                android:minHeight="48dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes una cuenta? " />

                <TextView
                    android:id="@+id/boton_entrar"
                    style="@style/TextLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="Inicia sesión" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>