<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_pantalla">

        <ImageView
            android:id="@+id/image_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_card_top" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/overlay_imagen"
            app:layout_constraintTop_toTopOf="@id/image_background"
            app:layout_constraintStart_toStartOf="@id/image_background"
            app:layout_constraintEnd_toEndOf="@id/image_background"
            app:layout_constraintBottom_toBottomOf="@id/image_background" />


        <ImageView
            android:id="@+id/logo_icon"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo_yipshare"
            android:contentDescription="@null"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toTopOf="@id/image_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_card_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="250dp" />

        <ProgressBar
            android:id="@+id/pbSubida_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="@id/image_background"
            app:layout_constraintStart_toStartOf="@id/image_background"
            app:layout_constraintEnd_toEndOf="@id/image_background" />

        <LinearLayout
            android:id="@+id/card_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="@id/guideline_card_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.85">

            <TextView
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="REGISTRAR CUENTA"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tv_error"
                style="@style/TextError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Error de inicio de sesión"
                android:visibility="gone" />

            <EditText
                android:id="@+id/apellido_paterno"
                style="@style/InputBrand"
                android:hint="Apellido Paterno"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/apellido_materno"
                style="@style/InputBrand"
                android:hint="Apellido Materno"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/nombres"
                style="@style/InputBrand"
                android:hint="Nombre(s)"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <ProgressBar
                android:id="@+id/pbSubida"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btn_siguiente"
                style="@style/ButtonPrimary"
                android:text="Siguiente"
                android:minHeight="48dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes una cuenta? " />

                <TextView
                    android:id="@+id/boton_regresar_Main"
                    style="@style/TextLink"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="5dp"
                    android:gravity="center_vertical"
                    android:text="Inicia sesión" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_terms"
                style="@style/TextLink"
                android:layout_width="298dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/footer_terminos" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>