<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <View
        android:id="@+id/bg_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/space_header" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <ImageView
        android:id="@+id/logo_yipshare"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/logo_yipshare"
        android:contentDescription="@null"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_status"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/logo_yipshare"
        app:layout_constraintBottom_toBottomOf="@id/logo_yipshare"
        app:layout_constraintStart_toEndOf="@id/logo_yipshare" />

    <ImageView
        android:id="@+id/iv_notificaciones"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_notification_bell"
        android:contentDescription="@string/notification"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/logo_yipshare"
        app:layout_constraintBottom_toBottomOf="@id/logo_yipshare"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/punto_notificaciones"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_punto_notificacion"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_notificaciones"
        app:layout_constraintEnd_toEndOf="@id/iv_notificaciones" />

    <ImageView
        android:id="@+id/iv_agregar_top"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_plus_icon"
        android:contentDescription="@string/imageView_agregar"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/iv_notificaciones"
        app:layout_constraintBottom_toBottomOf="@id/iv_notificaciones"
        app:layout_constraintEnd_toStartOf="@id/iv_notificaciones" />

    <TextView
        android:id="@+id/tv_condominio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_condominio"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/logo_yipshare"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_saludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_saludo"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_condominio"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_buscar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_search"
        android:hint="@string/et_buscar"
        android:textColorHint="@color/texto_hint"
        android:textSize="14sp"
        android:paddingStart="16dp"
        android:paddingEnd="40dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_saludo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_buscar_icono"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_search"
        app:tint="@color/texto_hint"
        android:contentDescription="@null"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/et_buscar"
        app:layout_constraintBottom_toBottomOf="@id/et_buscar"
        app:layout_constraintEnd_toEndOf="@id/et_buscar" />

    <Space
        android:id="@+id/space_header"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@id/et_buscar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/space_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_no_articulos"
                style="@style/TextLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tv_no_articulos"
                android:layout_marginTop="80dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_crear_condominio"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/btn_crear_condominio"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_no_articulos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.7" />

            <Button
                android:id="@+id/btn_unirse_condominio"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="@string/btn_unirse_condominio"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/btn_crear_condominio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.7" />

            <TextView
                android:id="@+id/tv_mis_articulos"
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_articulos"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_mis_articulos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:layout_constraintTop_toBottomOf="@id/tv_mis_articulos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_articulos_disponibles"
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_articulos_disponibles"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/rv_mis_articulos"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_articulos_disponibles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:layout_constraintTop_toBottomOf="@id/tv_articulos_disponibles"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_no_articulos, btn_crear_condominio, btn_unirse_condominio" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_content_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:visibility="gone"
                app:constraint_referenced_ids="tv_mis_articulos, rv_mis_articulos, tv_articulos_disponibles, rv_articulos_disponibles" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@color/azul_yipshare"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageViewInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_house_princial"
                app:tint="@android:color/white"
                android:contentDescription="@string/imageView_inicio" />

            <TextView
                android:id="@+id/textViewInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_inicio"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_prestamos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageViewPrestamos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_month"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_prestamos" />

            <TextView
                android:id="@+id/textViewPrestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_prestamos"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_agregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageViewAgregar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_plus_icon"
                app:tint="@android:color/white"
                android:contentDescription="@string/imageView_agregar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_reportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageViewReportes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_reportes" />

            <TextView
                android:id="@+id/textViewReportes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_reportes"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageViewPerfil"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_perfil" />

            <TextView
                android:id="@+id/textViewPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_perfil"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>