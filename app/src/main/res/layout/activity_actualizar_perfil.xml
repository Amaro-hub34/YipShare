<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_botones_sobreposicion"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#33000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_perfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:id="@+id/layoutPagoMes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pago del mes: "
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp" />

                        <CheckBox
                            android:id="@+id/cbPagoMes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sí, pagó este mes" />


                    </LinearLayout>
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textSize="16sp"
                        android:text="Usuario" />

                    <EditText
                        android:id="@+id/et_correo_electronico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textNoSuggestions"
                        />

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="16sp"
                        android:text="Contraseña"
                        />

                    <EditText
                        android:id="@+id/et_contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPassword"
                        android:hint="Contraseña"
                        android:maxLines="1"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/datos_personales"
                        style="@style/TextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Datos Personales"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        />
                    <EditText
                        android:id="@+id/apellido_paterno"
                        style="@style/InputBrand"
                        android:hint="Apellido Paterno"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />

                    <EditText
                        android:id="@+id/apellido_materno"
                        style="@style/InputBrand"
                        android:hint="Apellido Materno"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />

                    <EditText
                        android:id="@+id/nombres"
                        style="@style/InputBrand"
                        android:hint="Nombre(s)"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />


                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:text="Dirección:" />

                    <EditText
                        android:id="@+id/et_direccion_edificio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:hint="Ej: Edificio 2" />
                    <EditText
                        android:id="@+id/et_direccion_departamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:hint="Ej: Departamento: 14" />
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textSize="14sp"
                        android:text="Identificación Oficial" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_adjuntar_identificacion"
                            style="@style/ButtonSecundary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adjuntar PDF" />

                        <TextView
                            android:id="@+id/tv_archivo_identificacion"
                            style="@style/TextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            android:text="Ningún archivo seleccionado" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_actualizar_datos"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="Actualizar" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>