<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <View
        android:id="@+id/bg_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideline_header" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="70dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <TextView
        android:id="@+id/tv_titulo_pantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/textView_reportes"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/guideline_status"
        app:layout_constraintBottom_toTopOf="@id/guideline_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_perfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:id="@+id/layoutPagoMes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pagoMes"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp" />

                        <CheckBox
                            android:id="@+id/cbPagoMes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cbPagoMes" />


                    </LinearLayout>
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textSize="16sp"
                        android:text="" />

                    <TextView
                        android:id="@+id/et_correo_electronico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textNoSuggestions"
                        />

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="16sp"
                        android:text="@string/contrasena_actualizar_perfil"
                        />

                    <TextView
                        android:id="@+id/et_contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPassword"
                        android:hint="@string/AP_contrasena"
                        android:maxLines="1"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/datos_personales"
                        style="@style/TextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/datos_personales"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        />
                    <TextView
                        android:id="@+id/apellido_paterno"
                        style="@style/InputBrand"
                        android:hint="@string/apellido_paterno"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/apellido_materno"
                        style="@style/InputBrand"
                        android:hint="@string/apellido_materno"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/nombres"
                        style="@style/InputBrand"
                        android:hint="@string/nombres"
                        android:inputType="textPersonName"
                        android:background="@drawable/bg_input"
                        android:minHeight="48dp"
                        android:layout_marginBottom="14dp" />


                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:text="@string/tv_direccion" />

                    <TextView
                        android:id="@+id/et_direccion_edificio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:hint="@string/IC_et_direccion_edificio" />
                    <TextView
                        android:id="@+id/et_direccion_departamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:hint="@string/IC_et_direccion_departamento" />
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textSize="14sp"
                        android:text="@string/id_oficial" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_adjuntar_identificacion"
                            style="@style/ButtonSecundary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_adjuntar" />

                        <TextView
                            android:id="@+id/tv_archivo_identificacion"
                            style="@style/TextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            android:text="@string/tv_archivo" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:layout_marginTop="10dp"
                        android:text="@string/miCalificacion" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <RatingBar
                            android:id="@+id/rb_mi_calificacion"
                            style="@style/Widget.AppCompat.RatingBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:isIndicator="true"
                            android:progressTint="@color/azul_yipshare"
                            tools:rating="4" />

                        <TextView
                            android:id="@+id/tv_calificacion_numero"
                            style="@style/TextBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textStyle="bold"
                            android:text="4.0" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_actualizar_datos"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/btn_actualizar_datos" />

                    <Button
                        android:id="@+id/btn_eliminar_cuenta"
                        style="@style/ButtonSecundary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/btn_eliminar_cuenta" />
                    <Button
                        android:id="@+id/btn_sacar_habitante"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/btn_sacar_habitante"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@color/azul_yipshare"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_inicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_house_princial"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_inicio" />

            <TextView
                android:id="@+id/textView_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_inicio"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_prestamos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_prestamos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_month"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_prestamos" />

            <TextView
                android:id="@+id/textView_prestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_prestamos"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_agregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_agregar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_plus_icon"
                app:tint="@android:color/white"
                android:contentDescription="@string/imageView_agregar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_reportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_reportes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_reportes" />

            <TextView
                android:id="@+id/textView_reportes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_reportes"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_perfil"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="@android:color/white"
                android:contentDescription="@string/imageView_perfil" />

            <TextView
                android:id="@+id/textView_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_perfil"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>