<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/color_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layout_vecino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_nombre_vecino"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:text="carlos_ramirez" />

            <TextView
                android:id="@+id/tv_unidad_vecino"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Unidad 2 · Admin condominio" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RatingBar
                    android:id="@+id/rb_vecino"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:isIndicator="true"
                    android:progressTint="@color/azul_yipshare" />

                <TextView
                    android:id="@+id/tv_calificacion_vecino"
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    tools:text="4.5" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_telefono_vecino"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:textColor="@color/azul_yipshare"
            android:background="?attr/selectableItemBackground"
            tools:text="+52 55 1111 2222" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_puede_pedir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/puede_pedir_prestamos" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
