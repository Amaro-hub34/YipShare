<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/color_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_mensaje_union"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Quiere unirse a Residencial Los Pinos" />

        <LinearLayout
            android:id="@+id/layout_solicitante_union"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_solicitante_union"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                tools:text="maria_gomez" />

            <TextView
                android:id="@+id/tv_nombre_completo_union"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="María Gómez" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RatingBar
                    android:id="@+id/rb_solicitante_union"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:isIndicator="true"
                    android:progressTint="@color/azul_yipshare" />

                <TextView
                    android:id="@+id/tv_calificacion_union"
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    tools:text="0.0" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_unidad_union"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Dirección: Torre A 5" />

        <TextView
            android:id="@+id/tv_telefono_union"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:textColor="@color/azul_yipshare"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            tools:text="Teléfono: +525577778888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_denegar_union"
                style="@style/ButtonSecundary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textSize="14sp"
                android:text="@string/btn_denegar" />

            <Button
                android:id="@+id/btn_aceptar_union"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="14sp"
                android:text="@string/btn_aceptar" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
