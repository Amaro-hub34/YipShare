<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <View
        android:id="@+id/bg_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideline_header"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="70dp" />

    <ImageView
        android:id="@+id/btn_regresar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/white"
        android:contentDescription="@string/btnRegresar"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/bg_header"
        app:layout_constraintBottom_toBottomOf="@id/bg_header"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_titulo_pantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_titulo_pantalla"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/bg_header"
        app:layout_constraintBottom_toBottomOf="@id/bg_header"
        app:layout_constraintStart_toEndOf="@id/btn_regresar"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/solicitudes_recycleview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline_header"
        app:layout_constraintVertical_bias="1.0" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@color/azul_yipshare"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_inicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_house_princial"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_inicio" />

            <TextView
                android:id="@+id/textView_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_inicio"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_prestamos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_prestamos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_month"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_prestamos" />

            <TextView
                android:id="@+id/textView_prestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_prestamos"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_agregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_agregar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_plus_icon"
                app:tint="@android:color/white"
                android:contentDescription="@string/imageView_agregar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_reportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_reportes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_reportes" />

            <TextView
                android:id="@+id/textView_reportes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_reportes"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imageView_perfil"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="#99FFFFFF"
                android:contentDescription="@string/imageView_perfil" />

            <TextView
                android:id="@+id/textView_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textView_perfil"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>