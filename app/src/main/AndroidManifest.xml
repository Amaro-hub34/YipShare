<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YipShare">

        <activity
            android:name=".animation_yipshare.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PantallaPrincipalActivity"
            android:exported="false" />

        <activity
            android:name=".register.RegistroCuenta1Activity"
            android:exported="false" />

        <activity
            android:name=".TermsAndConditionsActivity"
            android:exported="false" />
        <activity android:name=".register.RegistroCuenta2Activity"
            android:exported="false" />
        <activity android:name=".RegistrarCondominioActivity"
            android:exported="false" />
        <activity android:name=".IngresoCondominioActivity"
            android:exported="false" />
        <activity android:name=".NotificacionActivity"
            android:exported="false" />
        <activity android:name=".PerfilActivity"
            android:exported="false" />
        <activity android:name=".DetalleArticuloActivity"
            android:exported="false" />
        <activity android:name=".ReporteActivity"
            android:exported="false" />
        <activity android:name=".PrestamoActivity"
            android:exported="false"/>
        <activity android:name=".CodigoPrestamoActivity"
            android:exported="false"/>
        <activity android:name=".FormularioArticuloActivity"
            android:exported="false"/>
        <activity android:name=".NeighborsActivity"
            android:exported="false" />
        <activity android:name=".UnitsActivity"
            android:exported="false" />
        <activity android:name=".CondominiumFeedbackActivity"
            android:exported="false" />
        <activity android:name=".UserFeedbackActivity"
            android:exported="false" />
        <activity android:name=".CalificarUsuarioActivity"
            android:exported="false"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>